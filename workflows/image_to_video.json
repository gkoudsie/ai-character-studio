{
  "_comment": "ComfyUI API-format workflow: Stable Video Diffusion (SVD) image-to-video. Takes one input image and animates it into a short clip. generate_videos.py fills in __PLACEHOLDER__ values and uploads the source image first. Outputs an mp4 via VHS_VideoCombine (ComfyUI-VideoHelperSuite).",

  "15": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": {
      "ckpt_name": "__VIDEO_MODEL__"
    }
  },

  "23": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "__SOURCE_IMAGE__"
    }
  },

  "12": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "width": "__WIDTH__",
      "height": "__HEIGHT__",
      "video_frames": "__NUM_FRAMES__",
      "motion_bucket_id": "__MOTION_BUCKET__",
      "fps": "__FPS__",
      "augmentation_level": 0.0,
      "clip_vision": ["15", 1],
      "init_image": ["23", 0],
      "vae": ["15", 2]
    }
  },

  "14": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__SEED__",
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["15", 0],
      "positive": ["12", 0],
      "negative": ["12", 1],
      "latent_image": ["12", 2]
    }
  },

  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["14", 0],
      "vae": ["15", 2]
    }
  },

  "30": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": ["8", 0],
      "frame_rate": "__FPS__",
      "loop_count": 0,
      "filename_prefix": "__FILENAME_PREFIX__",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "pingpong": false,
      "save_output": true
    }
  }
}
